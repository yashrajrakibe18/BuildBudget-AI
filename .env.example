# BuildBudget AI 2.0 - copy to .env and fill in what you use.
# Nothing secret belongs in Git. Every integration below is optional; missing
# values are reported as "not configured" instead of faking a result.

APP_NAME=BuildBudget AI
APP_ENV=development
APP_TIMEZONE=Asia/Kolkata
APP_CURRENCY=INR
APP_UNITS=imperial

# REQUIRED in production (any long random string). In development a random key
# is generated per start, so sessions reset when the dev server restarts.
SECRET_KEY=
DATABASE_URL=sqlite:///./buildbudget.db
# Production example: DATABASE_URL=postgresql+psycopg://bb:change-me@localhost:5432/buildbudget

# --- AI assistant (optional; the rest of the app works without it) -----------
# Use a model that supports tool calling. Pick ONE provider and install its extra:
#   uv sync --extra groq     or --extra google     or --extra openai (also OpenRouter)
LLM_PROVIDER=groq
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_MAX_AGENTS=4
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- Email: SMTP is implemented and used for all sends -----------------------
# Gmail: enable 2-step verification, create an App Password, never your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false   # set true for implicit TLS providers such as port 465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
NOTIFICATION_EMAIL=
EMAIL_ENABLED=false  # master switch for ALL providers, including local capture
MAIL_PROVIDER=smtp   # smtp | gmail_api | local (local captures mail to .run/mailbox; not delivered)
MAIL_FROM_NAME=BuildBudget AI
MAIL_REPLY_TO=
MAIL_DAILY_LIMIT=50
# Gmail API OAuth 2.0 (full mailbox sync) is NOT implemented in this build.
# These are only detected and reported as configured/unavailable.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Scheduler ---------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_IN_APP=false
# Keep in-app false and run exactly ONE scripts/run_scheduler.py process.
BUDGET_CHECK_INTERVAL_MINUTES=60
DAILY_SUMMARY_TIME=08:00

# --- Data science ------------------------------------------------------------
FORECAST_MIN_MONTHS=6
ANOMALY_Z_THRESHOLD=3.5

# --- Files and retrieval -----------------------------------------------------
MAX_UPLOAD_MB=15
API_PAGE_SIZE=50
ENABLE_OCR=false
RAG_BACKEND=hybrid
RAG_TOP_K=6
RAG_VECTOR_DIMS=512

DEMO_MODE=true
LOG_LEVEL=INFO
